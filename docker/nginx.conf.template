# Rendered by the nginx image's entrypoint (envsubst): ${API_UPSTREAM} and ${RESOLVER} are substituted.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 6;      # the default (1) leaves ~18% on the table for JS/CSS
    gzip_min_length 256;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hashed build assets never change; everything else (index.html) must be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; return 204; }   # no .ico shipped; don't serve index.html as an icon

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        try_files $uri $uri/ /index.html;   # SPA fallback for client-side routes
    }

    # A variable in proxy_pass makes nginx re-resolve the name (Docker's DNS) instead of caching the
    # api container's address forever, so the proxy survives the api being recreated or restarted.
    resolver ${RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        # Overwrite, don't append: the API rate-limits per client address and must not trust one the client supplied.
        # (Behind another proxy, this is that proxy's address; see TRUST_PROXY and README.)
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/security-headers.conf;
    }
}
