# Copy to .env (git-ignored) for the production compose file.
POSTGRES_PASSWORD=change-me
# Where the web service listens on the host. Default is loopback only; 0.0.0.0 exposes it on every interface.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080
# Image tag for radiozk-api / radiozk-web (e.g. a release version).
# TAG=latest
